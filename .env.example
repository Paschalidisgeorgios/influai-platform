# InfluExAI — environment placeholders (no real secrets)
# Copy to .env.local and fill values. Never commit .env.local.

# =============================================================================
# MVP REQUIRED — production launch
# =============================================================================

# App
NEXT_PUBLIC_APP_URL=

# Supabase (client + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-side hosted Checkout — no publishable key required today)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ULTIMATE=
# Monthly subscriptions (Stripe Billing → recurring Prices)
STRIPE_SUB_PRICE_CREATOR=
STRIPE_SUB_PRICE_PRO=
STRIPE_SUB_PRICE_STUDIO=
# Optional — not used by current Checkout redirect flow
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Generation providers (server-only)
FAL_KEY=
KREA_API_KEY=

# Generation worker auth
GENERATION_WORKER_SECRET=

# =============================================================================
# OPTIONAL — enhances features but not required for MVP live tools
# =============================================================================

# Prompt Assist LLM enhancement (passthrough fallback when missing)
OPENAI_API_KEY=

# LipSync system voice (only when enableLipSync module is on)
ELEVENLABS_API_KEY=
ENABLE_ELEVENLABS_TTS=false
NEXT_PUBLIC_ENABLE_ELEVENLABS_TTS=false

# Internal / admin
INTERNAL_VALIDATION_SECRET=
ADMIN_EMAILS=
ADMIN_DEV_SECRET=

# =============================================================================
# PROVIDER TOGGLES (default: enabled when matching API key is set)
# =============================================================================

ENABLE_FAL_PROVIDER=
NEXT_PUBLIC_ENABLE_FAL_PROVIDER=
ENABLE_KREA_PROVIDER=
NEXT_PUBLIC_ENABLE_KREA_PROVIDER=
ENABLE_KREA_ENHANCE=false
NEXT_PUBLIC_ENABLE_KREA_ENHANCE=false

# =============================================================================
# LAUNCH MODULE OVERRIDES (server — see app/lib/config/launch.ts)
# =============================================================================

ENABLE_MOTION_TRANSFER=false
NEXT_PUBLIC_ENABLE_MOTION_TRANSFER=false
ENABLE_LIVE_AVATAR=false
NEXT_PUBLIC_ENABLE_LIVE_AVATAR=false

# =============================================================================
# VALIDATION FIXTURES (admin live tests only)
# =============================================================================

# FAL_VALIDATION_AUDIO_URL=https://example.com/fixtures/test-audio.mp3
# KREA_VALIDATION_PORTRAIT_URL=https://example.com/fixtures/portrait.jpg
# KREA_VALIDATION_MOTION_VIDEO_URL=https://example.com/fixtures/motion.mp4
RUN_REAL_PROVIDER_SMOKE_TESTS=false
ALLOW_TRAINING_SMOKE_TESTS=false

# =============================================================================
# KREA OVERRIDES (optional — defaults in lib/providers/krea.ts)
# =============================================================================

KREA_API_BASE_URL=https://api.krea.ai
KREA_IMAGE_MODEL_PATH=bfl/flux-1-dev
KREA_MODEL_REFERENCE_EDIT=google/nano-banana-pro
KREA_MODEL_VIDEO=kling/kling-2.5
KREA_MODEL_ENHANCE=enhance/topaz/standard-enhance

# =============================================================================
# ELEVENLABS VOICE IDS (optional — LipSync system voice)
# =============================================================================

ELEVENLABS_VOICE_SARAH=
ELEVENLABS_VOICE_ROGER=
ELEVENLABS_VOICE_LAURA=
ELEVENLABS_VOICE_CHARLIE=
ELEVENLABS_VOICE_GEORGE=
ELEVENLABS_VOICE_CALLUM=
ELEVENLABS_VOICE_RIVER=
ELEVENLABS_VOICE_HARRY=
ELEVENLABS_VOICE_LIAM=
ELEVENLABS_VOICE_ALICE=
ELEVENLABS_VOICE_MATILDA=
ELEVENLABS_VOICE_WILL=
ELEVENLABS_VOICE_JESSICA=
ELEVENLABS_VOICE_ERIC=
ELEVENLABS_VOICE_BELLA=
ELEVENLABS_VOICE_CHRIS=
ELEVENLABS_VOICE_BRIAN=
ELEVENLABS_VOICE_DANIEL=
ELEVENLABS_VOICE_LILY=
ELEVENLABS_VOICE_ADAM=
ELEVENLABS_VOICE_BILL=
ELEVENLABS_VOICE_FEMALE_NATURAL=
ELEVENLABS_VOICE_FEMALE_SOFT=
ELEVENLABS_VOICE_FEMALE_ENERGETIC=
ELEVENLABS_VOICE_FEMALE_PREMIUM=
ELEVENLABS_VOICE_MALE_NATURAL=
ELEVENLABS_VOICE_MALE_DEEP=
ELEVENLABS_VOICE_MALE_STORYTELLING=
ELEVENLABS_VOICE_MALE_ENERGETIC=
NEXT_PUBLIC_ELEVENLABS_CONFIGURED_VOICE_KEYS=

# =============================================================================
# LEGACY / DISABLED FEATURE FLAGS (keep off at MVP)
# =============================================================================

ENABLE_CREATOR_VIDEO=false
NEXT_PUBLIC_ENABLE_CREATOR_VIDEO=false
ENABLE_TALKING_CREATOR=false
NEXT_PUBLIC_ENABLE_TALKING_CREATOR=false
ENABLE_LEGACY_OPENAI=false
NEXT_PUBLIC_ENABLE_LEGACY_OPENAI=false
ENABLE_CINEMA_AGENT=false
NEXT_PUBLIC_ENABLE_CINEMA_AGENT=false
ENABLE_OMNI_CAMPAIGN_AGENT=false
NEXT_PUBLIC_ENABLE_OMNI_CAMPAIGN_AGENT=false
ENABLE_WATERMARKED_PROMO=false
NEXT_PUBLIC_ENABLE_WATERMARKED_PROMO=false
ENABLE_SOCIAL_PLANNER=false
NEXT_PUBLIC_ENABLE_SOCIAL_PLANNER=false
ENABLE_COMPLIANCE_CHECK=false
NEXT_PUBLIC_ENABLE_COMPLIANCE_CHECK=false
ENABLE_UGC_LOOK=false
NEXT_PUBLIC_ENABLE_UGC_LOOK=false

# Creatify (migration POC — off at MVP)
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_API_BASE_URL=https://api.creatify.ai
CREATIFY_AD_VIDEO_MODEL=kling-video/v1.6/image-to-video
ENABLE_CREATIFY_PROVIDER=false
NEXT_PUBLIC_ENABLE_CREATIFY_PROVIDER=false

# Cron / worker
CRON_SECRET=

# Prompt copilot model override (optional)
# PROMPT_COPILOT_MODEL=gpt-4o-mini
# PROMPT_COPILOT_PROVIDER=openai

# See docs/ENVIRONMENT.md and docs/PROVIDER_READINESS.md
