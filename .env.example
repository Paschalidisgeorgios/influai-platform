ELEVENLABS_VOICE_MALE_ENERGETIC=
# Optional: comma-separated voice keys enabled in Lip Sync UI (must match configured server IDs above)
NEXT_PUBLIC_ELEVENLABS_CONFIGURED_VOICE_KEYS=

# Creator tools (planning-only unless stated)
ENABLE_CINEMA_AGENT=false
NEXT_PUBLIC_ENABLE_CINEMA_AGENT=false
ENABLE_OMNI_CAMPAIGN_AGENT=false
NEXT_PUBLIC_ENABLE_OMNI_CAMPAIGN_AGENT=false
ENABLE_WATERMARKED_PROMO=false
NEXT_PUBLIC_ENABLE_WATERMARKED_PROMO=false
ENABLE_SOCIAL_PLANNER=false
NEXT_PUBLIC_ENABLE_SOCIAL_PLANNER=false
ENABLE_COMPLIANCE_CHECK=false
NEXT_PUBLIC_ENABLE_COMPLIANCE_CHECK=false

# UGC Look (OpenAI Standard flow with UGC prompt-building)
ENABLE_UGC_LOOK=false
NEXT_PUBLIC_ENABLE_UGC_LOOK=false

# Krea AI (primary generation provider when enabled)
KREA_API_KEY=
ENABLE_KREA_PROVIDER=false
NEXT_PUBLIC_ENABLE_KREA_PROVIDER=false
ENABLE_KREA_ENHANCE=false
NEXT_PUBLIC_ENABLE_KREA_ENHANCE=false
# Optional legacy OpenAI image (disabled — Krea-only platform)
ENABLE_LEGACY_OPENAI=false
NEXT_PUBLIC_ENABLE_LEGACY_OPENAI=false
# Optional overrides
KREA_API_BASE_URL=https://api.krea.ai
KREA_IMAGE_MODEL_PATH=bfl/flux-1-dev
KREA_MODEL_REFERENCE_EDIT=google/nano-banana-pro
KREA_MODEL_VIDEO=kling/kling-2.5
KREA_MODEL_ENHANCE=enhance/topaz/standard-enhance
# Optional: API path segment after /generate/enhance/ (default topaz/standard-enhance)
# KREA_ENHANCE_API_PATH=topaz/standard-enhance

# Live Avatar Studio (Motion Transfer — animate a creator portrait with a driving video)
ENABLE_LIVE_AVATAR=false
NEXT_PUBLIC_ENABLE_LIVE_AVATAR=false
# Fallback provider model (fal.ai live portrait / motion transfer). Override if needed.
FAL_MOTION_TRANSFER_MODEL=fal-ai/live-portrait
# Optional: only set if/when a confirmed Krea motion-transfer endpoint exists.
# When set, Krea is tried first; otherwise the fal.ai fallback above is used.
# KREA_MOTION_TRANSFER_MODEL_PATH=

# Creatify AI (provider migration POC)
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_API_BASE_URL=https://api.creatify.ai
CREATIFY_AD_VIDEO_MODEL=kling-video/v1.6/image-to-video
ENABLE_CREATIFY_PROVIDER=false
NEXT_PUBLIC_ENABLE_CREATIFY_PROVIDER=false

# Generation worker
GENERATION_WORKER_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ULTIMATE=

# App URL
NEXT_PUBLIC_APP_URL=

